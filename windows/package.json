{
  "name": "hawwil",
  "productName": "حوّل",
  "version": "1.0.0",
  "description": "حوّل (Hawwil): تحويل الملفات وأدواتها بعجلة سريعة",
  "main": "main.js",
  "scripts": {
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "app.hawwil.desktop",
    "productName": "Hawwil",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}